# Shared configuration for the MCP trust demo.
# Sourced by setup.sh, mcp-trust.sh and reset.sh.

# Local OCI registry. Port 5001 because macOS AirPlay Receiver squats on 5000.
REG_PORT=5001
REG_HOST="localhost:${REG_PORT}"
REG_CONTAINER="mcp-demo-registry"

REPO="${REG_HOST}/mcp/server-everything"
TAG="2.0.0"
KIT_REF="${REPO}:${TAG}"

# Upstream MCP server, vendored pre-built from modelcontextprotocol/servers
# (src/everything) at commit d31124c. Nothing clones or compiles on stage.
SERVER_DIR="server"

# MCPB staging directory: manifest.json + server/ + bundled production deps.
# setup.sh assembles this; `mcpb pack` turns it into the .mcpb on stage.
BUNDLE_DIR="bundle"

# Where the built .mcpb lands, and where `kit init` writes its Kitfile.
# Kept as its own directory so kit init sees the bundle and nothing else.
PKG_DIR="package"
MCPB_FILE="${PKG_DIR}/server-everything.mcpb"

# Backup of the bundle entry point, so reset.sh can undo the tamper.
PRISTINE_ENTRY=".pristine-index.js"

# Cosign material, generated once by setup.sh.
KEYS_DIR="keys"
COSIGN_KEY="${KEYS_DIR}/cosign.key"
COSIGN_PUB="${KEYS_DIR}/cosign.pub"
SIGNING_CONFIG="${KEYS_DIR}/offline-signing-config.json"

# Empty passphrase so the demo never blocks on a prompt.
export COSIGN_PASSWORD=""

# --- Provenance inputs -------------------------------------------------------
# The upstream the vendored server/ was copied from. Recorded here because the
# vendored copy carries no .git; in a real pipeline CI reads this from the
# checkout it built.
SOURCE_URI="git+https://github.com/modelcontextprotocol/servers"
SOURCE_COMMIT="d31124c982401739917fd817c2a59db344529c16"
SOURCE_ENTRYPOINT="src/everything"

# buildType for the provenance predicate. NOTE: JZ-SPEC-ATTESTATION-001 §8
# registers import, scan and validity predicates but nothing for a pack-time
# build, and §8 says new types MUST be registered before use. This URI is a
# placeholder for that missing registration - change it in one place here.
BUILD_TYPE="https://jozu.dev/kitops/mcpb-pack/v1"

PROVENANCE_FILE="provenance.json"
SBOM_FILE="sbom.json"
